<?xml version="1.0" encoding="utf-8"?>
<!-- Languages the launcher is translated into. Lets Android 13+ give the launcher its own language
     (set it with "cmd locale set-app-locales", see the README), since TVs rarely offer
     every language system-wide.
     This build ships en/zh/zh-rCN/zh-rTW only (the other locale folders were moved to
     tmp\lang_backup), so the list is cut down to match. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh-CN" />
    <locale android:name="zh-TW" />
</locale-config>
