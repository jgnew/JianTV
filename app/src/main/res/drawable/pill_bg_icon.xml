<?xml version="1.0" encoding="utf-8"?>
<!-- Top-bar icon buttons (reorder / app library): bare icon while unfocused, a GenTV-style glass chip
     while focused — 19% white fill, 1dp white hairline, 14dp corners. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#30FFFFFF" />
            <stroke android:width="1dp" android:color="#88FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
