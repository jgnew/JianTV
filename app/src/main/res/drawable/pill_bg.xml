<?xml version="1.0" encoding="utf-8"?>
<!-- Top-bar text pills (Inputs / Wi-Fi / Settings). Unfocused: the usual faint frosted gradient.
     Focused: GenTV-style glass — 19% white fill plus a 1dp white hairline, keeping the 20dp capsule
     radius so the pill does not change shape when it takes focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#30FFFFFF" />
            <stroke android:width="1dp" android:color="#88FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
