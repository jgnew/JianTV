<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/reorderChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/reorder"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/columns_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/rows_below_dock_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dock_opacity_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" tools:ignore="HardcodedText" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/glow_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/glowOff" style="@style/SettingsColumnChoice" android:text="@string/glow_off" />
            <TextView android:id="@+id/glowFollow" style="@style/SettingsColumnChoice" android:text="@string/glow_follow" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/bar_style_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/barPill" style="@style/SettingsColumnChoice" android:text="@string/bar_style_pill" />
            <TextView android:id="@+id/barIcon" style="@style/SettingsColumnChoice" android:text="@string/bar_style_icon" />
            <TextView android:id="@+id/barGear" style="@style/SettingsColumnChoice" android:text="@string/bar_style_gear" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dream_name"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
            <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
            <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:text="@string/clock_format_24" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/idle_clock_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/idleOff" style="@style/SettingsColumnChoice" android:text="@string/idle_clock_off" />
            <TextView android:id="@+id/idle3" style="@style/SettingsColumnChoice" android:text="@string/idle_clock_3" />
            <TextView android:id="@+id/idle8" style="@style/SettingsColumnChoice" android:text="@string/idle_clock_8" />
            <TextView android:id="@+id/idle12" style="@style/SettingsColumnChoice" android:text="@string/idle_clock_12" />
        </LinearLayout>

        <TextView
            android:id="@+id/wallpaperChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/barButtonsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/advancedChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/advanced_effects_warning"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/openOnStartChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/followThemeChoice"
            android:visibility="gone"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/follow_theme" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:visibility="gone"
            android:text="@string/follow_theme_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/defaultHomeChoice"
            android:visibility="gone"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/home_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:visibility="gone"
            android:text="@string/home_settings_help"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            android:visibility="gone"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/tv_settings" />
    </LinearLayout>
</ScrollView>
